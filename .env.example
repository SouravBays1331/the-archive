# The Archive — environment template. Copy to .env.local and fill in.
# Session signing secret (>= 24 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Credentials: username:bcryptHash[,tier] — $ encoded as ~ (see README).
# Generate a line: npm run hash -- mypassword
ARCHIVE_USERS=

# Set to 1 ONLY when testing a production build over plain http (disables cookie Secure flag).
COOKIE_INSECURE=0

# Optional: enables the librarian LLM. Without it, a grounded keyword fallback is used.
# ANTHROPIC_API_KEY=
# LIBRARIAN_MODEL=claude-sonnet-4-20250514
# LIBRARIAN_LLM=on
